# SILK CLI - Gitignore

# OS
.DS_Store
Thumbs.db
*.tmp
*~

# IDE
.vscode/
.idea/
*.swp
*.swo

# SILK temporaires
outputs/temp/
.silk-cache/

# SILK backups et tests
silk-backup-*/
silk-test-suite/
*-test-project/
test-*/

# Scripts debug temporaires (devtools/ est tracké)
debug-*.sh
!devtools/debug-*.sh

# Sauvegardes
*.backup.*
silk.broken.*

# Log files
*.log
logs/
silk-integration.log

# Distribution
dist/
build/
*.tar.gz
*.zip

# Local config
.env
.env.local
config.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
